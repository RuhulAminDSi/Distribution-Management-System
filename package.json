{
  "name": "distribution-management",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev -- --host"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
